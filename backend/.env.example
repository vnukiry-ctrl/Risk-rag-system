GROQ_API_KEY=

# Embeddings (Milestone 6.4) -- voyage-law-2 is domain-tuned for legal/
# contract text, which insurance policies are. Get a key at
# https://dashboard.voyageai.com (free tier: 50M tokens on this model).
VOYAGE_API_KEY=

# Postgres connection string (Milestone 6.2) -- documents_db persistence.
# Works unchanged against Supabase, RDS, or a local instance. Get this from
# your Supabase project's Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# API hardening (Milestone 6.1). Comma-separated -- issue one key per caller
# (frontend, scripts, etc.) so they can be rotated independently. Leaving
# this unset disables auth entirely, which main.py only tolerates for local
# dev -- it logs a warning on startup so that's never silent.
API_KEYS=
